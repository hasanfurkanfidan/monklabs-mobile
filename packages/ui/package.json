{
  "name": "@monklabs/ui",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanfurkanfidan/monklabs-mobile.git",
    "directory": "packages/ui"
  },
  "description": "Small, theme-aware React Native component library shared by MonkLabs apps.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "react-native-safe-area-context": ">=5.0.0",
    "@monklabs/theme": "workspace:^"
  },
  "devDependencies": {
    "@monklabs/theme": "workspace:*",
    "@react-native/jest-preset": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "expo": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
