{
  "name": "@monklabs/playground",
  "version": "0.1.0",
  "private": true,
  "description": "Development app for visually verifying @monklabs/theme and @monklabs/ui. Not a product.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "expo:check": "expo install --check && expo config --type public --json"
  },
  "dependencies": {
    "@monklabs/theme": "workspace:*",
    "@monklabs/ui": "workspace:*",
    "expo": "catalog:",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-expo": "catalog:",
    "test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
